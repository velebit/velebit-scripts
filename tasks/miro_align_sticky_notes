"""Realign sticky notes in a Miro frame to a regular grid."""

# Realign sticky notes in the specified frame.
import argparse
from enum import Enum
from typing import Mapping

from bert_miro import (
    get_board,
    get_frame,
    create_item_id_to_group_mapping,
    StickyNote,
    Group,
)
from bert_miro_grid import (
    GridSpacingMode,
    StickyNoteGrid,
)

MOVE_THRESHOLD = 1e-6


class GridAxes(Enum):
    """Which axes should be adjusted when applying grid positions."""

    X_AND_Y = "xy"
    X_ONLY = "x"
    Y_ONLY = "y"


def move_with_group(
    sticky: StickyNote,
    dx: float,
    dy: float,
    *,
    dry_run: bool = False,
    verbosity: int = 0,
    group_map: Mapping[str, Group] | None = None,
) -> None:
    """Move a sticky note and all items in its top-level group by the same delta."""

    assert sticky.board is not None, f"Sticky note {sticky.id} has no board"
    if group_map is None:
        group_map = create_item_id_to_group_mapping(sticky.board)
    if sticky.id in group_map:
        group_obj = group_map[sticky.id]
        while group_obj.id in group_map:
            group_obj = group_map[group_obj.id]
        movable_items = group_obj.get_items_recursive()
    else:
        movable_items = [sticky]

    for item in movable_items:
        position = item.relative_position
        assert position is not None, f"Item {item.id} has no position"
        desc = f"{type(item).__name__} {item.id} ({item.text!r})"
        if not dry_run:
            if verbosity >= 1:
                print(f"Moving {desc} by ({dx}, {dy})")
            item.set_relative_position((position[0] + dx, position[1] + dy))
        else:
            if verbosity >= 0:
                print(f"Would move {desc} by ({dx}, {dy})")


def apply_axes(
    axes: GridAxes, *, old: tuple[float, float], new: tuple[float, float]
) -> tuple[float, float]:
    """Combine old/new coordinates according to the selected axis mode."""

    if axes == GridAxes.X_ONLY:
        return (new[0], old[1])
    elif axes == GridAxes.Y_ONLY:
        return (old[0], new[1])
    else:
        return new


def update_stickies(
    board_name_or_id: str,
    frame_name_or_id: str,
    *,
    spacing_mode: GridSpacingMode = GridSpacingMode.EQUAL,
    adjust_axes: GridAxes = GridAxes.X_AND_Y,
    dry_run: bool = False,
    verbosity: int = 0,
    print_empty_warnings: bool | None = None,
    print_grid_warnings: bool | None = None,
) -> None:
    """Compute and apply sticky-note moves needed to align notes in a frame."""

    print_empty_warnings = (
        print_empty_warnings if print_empty_warnings is not None else verbosity >= 0
    )
    print_grid_warnings = (
        print_grid_warnings if print_grid_warnings is not None else verbosity >= 0
    )

    board = get_board(board_name_or_id, board_name_or_id, verbosity=verbosity)
    frame = get_frame(board, frame_name_or_id, frame_name_or_id, verbosity=verbosity)

    sticky_notes = frame.sticky_notes()
    if not sticky_notes:
        if print_empty_warnings:
            print(
                f"No sticky notes found in frame {frame_name_or_id!r} on board {board_name_or_id!r}!"
            )
        return

    grid = StickyNoteGrid(sticky_notes)
    grid.check_grid_overlaps()
    if verbosity >= 0:
        smaller_most_common_size = min(grid.most_common_sticky_dimensions())
        spacing = grid.new_spacing(spacing_mode)
        size = grid.grid_size()

        # If the grid size is only 1 in a dimentsion, spacing doesn't matter so skip warning
        if (
            spacing[0] < smaller_most_common_size
            and size[0] > 1
            and print_grid_warnings
        ):
            print(
                f"X spacing {spacing[0]} is smaller than sticky size {smaller_most_common_size}, proceeding anyway"
            )
        if (
            spacing[1] < smaller_most_common_size
            and size[1] > 1
            and print_grid_warnings
        ):
            print(
                f"Y spacing {spacing[1]} is smaller than sticky size {smaller_most_common_size}, proceeding anyway"
            )

    xy_moves = tuple(
        (s, grid.sticky_original_position(s), grid.sticky_new_position(s, spacing_mode))
        for s in sticky_notes
    )
    moves = tuple((s, o, apply_axes(adjust_axes, old=o, new=n)) for s, o, n in xy_moves)

    # Count how many are actually moving
    num_moving = 0
    for sticky, old_pos, new_pos in moves:
        dx, dy = new_pos[0] - old_pos[0], new_pos[1] - old_pos[1]
        if abs(dx) > MOVE_THRESHOLD or abs(dy) > MOVE_THRESHOLD:
            num_moving += 1

    if num_moving > 0 and verbosity >= 1:
        min_old_x = min(m[1][0] for m in moves)
        max_old_x = max(m[1][0] for m in moves)
        min_old_y = min(m[1][1] for m in moves)
        max_old_y = max(m[1][1] for m in moves)
        min_new_x = min(m[2][0] for m in moves)
        max_new_x = max(m[2][0] for m in moves)
        min_new_y = min(m[2][1] for m in moves)
        max_new_y = max(m[2][1] for m in moves)

        amounts = {
            "Left": min_new_x - min_old_x,
            "Right": max_new_x - max_old_x,
            "Top": min_new_y - min_old_y,
            "Bottom": max_new_y - max_old_y,
        }
        for k, v in amounts.items():
            vv = f"{v:+.3f}" if abs(v) > MOVE_THRESHOLD else "0"
            print(f"{k:<6s} moving by {vv}")

    # Execute moves
    if num_moving > 0:
        group_map = create_item_id_to_group_mapping(board)
        for sticky, old_pos, new_pos in moves:
            dx, dy = new_pos[0] - old_pos[0], new_pos[1] - old_pos[1]
            if abs(dx) > MOVE_THRESHOLD or abs(dy) > MOVE_THRESHOLD:
                move_with_group(
                    sticky,
                    dx,
                    dy,
                    group_map=group_map,
                    verbosity=verbosity,
                    dry_run=dry_run,
                )


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments for sticky-note grid alignment."""

    parser = argparse.ArgumentParser(
        description="Realign sticky notes in a Miro frame to a regular grid."
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="Produce more verbose informational output (can be specified multiple times).",
    )
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_const",
        dest="verbose",
        const=-1,
        help="Suppress informational output.",
    )
    parser.add_argument(
        "--quiet-empty",
        action="store_true",
        default=None,
        help=(
            "Do not print a warning when the selected frame has no sticky notes. "
            "(The default is to print a warning unless -q is specified.)"
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show planned moves without applying them to the board.",
    )
    parser.add_argument(
        "--equal",
        action="store_const",
        dest="spacing_mode",
        const=GridSpacingMode.EQUAL,
        default=GridSpacingMode.EQUAL,
        help=(
            "Rebuild the grid with uniform column and row gaps. All neighboring notes will end up "
            "equally spaced while keeping the grid boundaries the same (default)."
        ),
    )
    parser.add_argument(
        "--extend-strict",
        action="store_const",
        dest="spacing_mode",
        const=GridSpacingMode.INTERNAL_STRICT,
        help=(
            "Preserve the current internal gaps by extending the existing row/column pitch inferred from the notes. "
            "If there aren't enough notes to infer a pitch, the grid will not be adjusted."
        ),
    )
    parser.add_argument(
        "--extend",
        action="store_const",
        dest="spacing_mode",
        const=GridSpacingMode.INTERNAL_OR_EQUAL,
        help=(
            "Try to preserve the current internal row/column pitch, but fall back to uniform equal spacing "
            "when there aren't enough notes to infer a pitch."
        ),
    )
    parser.add_argument(
        "--tight",
        action="store_const",
        dest="spacing_mode",
        const=GridSpacingMode.TIGHT,
        help=(
            "Keep a fixed minimal pitch between rows and columns while keeping the same grid ordering. "
            "Horizontally, the minimal pitch is the same as the horizontal edge-to-edge placement in the Miro UI "
            "(i.e. the pitch is the same as Miro's sticky note width). Vertically, the minimal pitch is *smaller* "
            "than edge-to-edge, and intends to make vertical spacing visually consistent with horizontal spacing."
        ),
    )
    parser.add_argument(
        "--tiled",
        action="store_const",
        dest="spacing_mode",
        const=GridSpacingMode.TILED,
        help=(
            "Tile notes edge-to-edge using sticky dimensions so adjacent notes touch. "
            "Note that Miro renders sticky notes as narrower than their reported dimensions, so there will be "
            "visual gaps, especially vertically. For more uniform gaps, use --tight instead."
        ),
    )
    parser.add_argument(
        "--x-only",
        action="store_const",
        dest="adjust_axes",
        const=GridAxes.X_ONLY,
        default=GridAxes.X_AND_Y,
        help="Adjust only X positions and keep Y positions unchanged.",
    )
    parser.add_argument(
        "--y-only",
        action="store_const",
        dest="adjust_axes",
        const=GridAxes.Y_ONLY,
        help="Adjust only Y positions and keep X positions unchanged.",
    )
    parser.add_argument(
        "board",
        help="Board name or board ID containing the frame to align.",
    )
    parser.add_argument(
        "frame",
        help="Frame name or frame ID whose sticky notes will be realigned.",
    )
    settings = parser.parse_args()
    return settings


def main() -> None:
    """Entry point for command-line execution."""

    settings = parse_args()
    update_stickies(
        settings.board,
        frame_name_or_id=settings.frame,
        spacing_mode=settings.spacing_mode,
        adjust_axes=settings.adjust_axes,
        verbosity=settings.verbose,
        print_empty_warnings=False if settings.quiet_empty else None,
        dry_run=settings.dry_run,
    )


if __name__ == "__main__":
    main()
