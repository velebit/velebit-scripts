# Move sticky notes on the specified board.
import argparse
from bert_miro import get_board, create_item_id_to_group_mapping, StickyNote, Item


def update_stickies(
    board_name_or_id: str,
    note_text: str,
    *,
    dx: float,
    dy: float,
    dry_run: bool = False,
    verbosity: int = 0,
    move_solo: bool = False,
    move_group: bool = False,
) -> None:
    board = get_board(board_name_or_id, board_name_or_id, verbosity=verbosity)
    matches: list[StickyNote] = []

    for note in board.sticky_notes():
        if note.text == note_text:
            matches.append(note)

    if len(matches) == 0:
        if verbosity >= 0:
            print(
                f"No sticky notes with text {note_text!r} found on board {board_name_or_id!r}!"
            )
        return
    elif len(matches) > 1:
        if verbosity >= 0:
            print(
                f"{len(matches)} sticky notes with text {note_text!r} found on board {board_name_or_id!r}, skipping!"
            )
        return

    sticky = matches[0]
    group_map = create_item_id_to_group_mapping(board)

    if sticky.id not in group_map:
        movable_items: list[Item] = [sticky]
        if verbosity >= 1:
            print(f"Moving sticky note {note_text!r} by ({dx}, {dy})")

    elif move_solo:
        movable_items = [sticky]
        if verbosity >= 1:
            print(
                f"Moving sticky note {note_text!r} by ({dx}, {dy}) [solo mode, ignoring group]"
            )

    elif move_group:
        group_obj = group_map[sticky.id]
        while group_obj.id in group_map:
            group_obj = group_map[group_obj.id]
        movable_items = group_obj.get_items_recursive()
        if verbosity >= 1:
            print(
                f"Moving {len(movable_items)} items in group containing {note_text!r} by ({dx}, {dy}) [group mode]"
            )

    else:
        if verbosity >= 0:
            print(
                f"Sticky note {note_text!r} is in a group, skipping! Use --solo or --group to override."
            )
        return

    items_without_position = [
        item for item in movable_items if item.relative_position is None
    ]
    if items_without_position:
        print(
            f"Error: {len(items_without_position)} item(s) have no position, not moving anything!"
        )
        if verbosity >= 1:
            for item in items_without_position:
                print(f"    {item!r}")
        return

    for item in movable_items:
        position = item.relative_position
        assert position is not None
        ox, oy = position
        nx, ny = ox + dx, oy + dy
        if not dry_run:
            item.set_relative_position((nx, ny))
            if verbosity >= 2:
                print(f"Moved item {item.id!r} from ({ox}, {oy}) to ({nx}, {ny})")
        else:
            if verbosity >= 0:
                print(
                    f"Would move item {item.id!r} from ({ox}, {oy}) to ({nx}, {ny}) [dry run]"
                )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("-v", "--verbose", action="count", default=0)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Perform a dry run without making any changes",
    )
    parser.add_argument("board")
    parser.add_argument("note_text")
    parser.add_argument("dx", type=float)
    parser.add_argument("dy", type=float)
    group_behavior = parser.add_mutually_exclusive_group()
    group_behavior.add_argument(
        "--solo",
        action="store_true",
        help="Move only the note, even if it's part of a group",
    )
    group_behavior.add_argument(
        "--group",
        action="store_true",
        help="Move the entire group if the note is part of one",
    )
    settings = parser.parse_args()
    return settings


def main() -> None:
    settings = parse_args()
    update_stickies(
        settings.board,
        note_text=settings.note_text,
        dx=settings.dx,
        dy=settings.dy,
        verbosity=settings.verbose,
        dry_run=settings.dry_run,
        move_solo=settings.solo,
        move_group=settings.group,
    )


if __name__ == "__main__":
    main()
