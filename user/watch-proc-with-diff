#!/bin/bash
# Usage: watch-proc-with-diff PROC_NAME
# Watches the pstree of each top-level PROC_NAME process and highlights changes between refreshes.

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $(basename "$0") PROC_NAME" >&2
    exit 1
fi
proc="$1"

# Reduce columns for pstree by 1, to accomodate diffing
pscols="$(( ${COLUMNS:-$(tput cols 2>/dev/null || echo 80)} - 1 ))"

script_path="$(realpath "$0")"
script_dir="$(dirname "${script_path}")"
# The header shows the PROC_NAME arg via WATCH_CMD_LABEL instead of the long inline script.
# Children of a same-named parent are skipped, so only top-level processes are shown.
# shellcheck disable=SC2016 # The inline script is intentionally single-quoted; its $vars expand in the inner bash.
WATCH_CMD_LABEL="${proc}" exec "${script_dir}/watch-cmd-with-diff" \
    bash -c '
        proc="$1"; pscols="$2";
        for p in $(ps -eo pid=,ppid=,comm= | awk -v proc="${proc}" '\''{pp[$1]=$2; c[$1]=$3}
                END{for(p in c)if(c[p]==proc){a=pp[p];
                while(a>1&&c[a]!=proc)a=pp[a];
                if(c[a]!=proc)print p}}'\'' | sort -n); do
            COLUMNS="${pscols}" pstree -pnT -Cage "$p"; done' \
    _ "${proc}" "${pscols}"
