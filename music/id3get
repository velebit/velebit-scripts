"""Extract selected ID3 tags from files."""

import argparse

from id3tools import all_props, get_valid_id3_tag


def parse_args() -> argparse.Namespace:
    """Parse the requested frame and output-format options."""
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-a", "--ascii", "--unidecode", action="store_true", default=False
    )
    parser.add_argument("-r", "--raw", action="store_true", default=False)
    parser.add_argument("frame_id")
    parser.add_argument("files", nargs="*")
    settings = parser.parse_args()
    return settings


def show_file(file: str, settings: argparse.Namespace) -> None:
    """Print the requested frame value found in one file."""
    tag = get_valid_id3_tag(file)
    if not tag:
        return
    for info in all_props(tag, as_ascii=settings.ascii, raw=settings.raw):
        if info["id"] == settings.frame_id:
            print(info["pretty"])


def main() -> None:
    """Parse arguments and extract the requested frame from each file."""
    settings = parse_args()
    for file in settings.files:
        show_file(file, settings)


if __name__ == "__main__":
    main()
